.screen {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 34px;
    padding-top: 34px;
}

.motion-card {
    width: 520px;
    padding: 22px;
    background-color: rgba(12, 17, 29, 0.94);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.header-row,
.motion-row,
.blend-header,
.status-pill,
.header-actions {
    flex-direction: row;
    align-items: center;
}

.header-row,
.blend-header {
    justify-content: space-between;
}

.header-actions {
    align-items: center;
}

.title-stack {
    flex-grow: 1;
}

.eyebrow {
    color: rgb(136, 149, 174);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.title {
    color: rgb(248, 250, 255);
    font-size: 25px;
    -unity-font-style: bold;
}

.status-pill {
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(78, 215, 157, 0.12);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.collapse-button {
    width: 30px;
    height: 30px;
    margin-left: 8px;
    color: rgb(198, 198, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    font-size: 18px;
    -unity-font-style: bold;
}

.collapse-button:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(55, 57, 112);
}

.status-dot {
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background-color: rgb(78, 215, 157);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.status-text {
    color: rgb(111, 232, 181);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.motion-row {
    margin-top: 19px;
}

.outfit-section {
    margin-top: 17px;
}

.outfit-eyebrow {
    margin-bottom: 2px;
}

.outfit-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.cloth-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.cloth-toggle {
    flex-grow: 1;
    height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    align-items: center;
    color: rgb(221, 226, 238);
    background-color: rgb(28, 35, 51);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(52, 62, 82);
    border-right-color: rgb(52, 62, 82);
    border-top-color: rgb(52, 62, 82);
    border-bottom-color: rgb(52, 62, 82);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    font-size: 12px;
    -unity-font-style: bold;
}

.cloth-toggle .unity-toggle__input {
    margin-right: 9px;
    border-left-color: rgb(103, 100, 234);
    border-right-color: rgb(103, 100, 234);
    border-top-color: rgb(103, 100, 234);
    border-bottom-color: rgb(103, 100, 234);
}

.cloth-toggle:checked .unity-toggle__input {
    background-color: rgb(91, 88, 220);
}

.outfit-label {
    width: 69px;
    color: rgb(136, 149, 174);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.outfit-selector {
    flex-grow: 1;
    height: 36px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 35, 51);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(52, 62, 82);
    border-right-color: rgb(52, 62, 82);
    border-top-color: rgb(52, 62, 82);
    border-bottom-color: rgb(52, 62, 82);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.outfit-arrow-button {
    width: 42px;
    height: 34px;
    color: rgb(183, 183, 255);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 27px;
    -unity-font-style: bold;
}

.outfit-arrow-button:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(55, 57, 112);
}

.outfit-arrow-button:active {
    background-color: rgb(73, 73, 151);
}

.outfit-name {
    flex-grow: 1;
    color: rgb(248, 250, 255);
    font-size: 13px;
    -unity-font-style: bold;
    unity-text-align: middle-center;
}

.motion-button,
.pause-button {
    height: 48px;
    color: rgb(207, 214, 229);
    background-color: rgb(28, 35, 51);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(52, 62, 82);
    border-right-color: rgb(52, 62, 82);
    border-top-color: rgb(52, 62, 82);
    border-bottom-color: rgb(52, 62, 82);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
}

.motion-button {
    flex-grow: 1;
    margin-right: 8px;
}

.pause-button {
    width: 92px;
}

.motion-button:hover,
.pause-button:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(38, 47, 68);
    border-left-color: rgb(93, 108, 143);
    border-right-color: rgb(93, 108, 143);
    border-top-color: rgb(93, 108, 143);
    border-bottom-color: rgb(93, 108, 143);
}

.motion-button:active,
.pause-button:active {
    background-color: rgb(45, 55, 80);
}

.motion-button--active {
    color: rgb(255, 255, 255);
    background-color: rgb(91, 88, 220);
    border-left-color: rgb(132, 129, 255);
    border-right-color: rgb(132, 129, 255);
    border-top-color: rgb(132, 129, 255);
    border-bottom-color: rgb(132, 129, 255);
}

.motion-button--active:hover {
    background-color: rgb(103, 100, 234);
}

.pause-button--active {
    color: rgb(255, 226, 158);
    background-color: rgba(230, 168, 56, 0.18);
    border-left-color: rgba(255, 200, 93, 0.55);
    border-right-color: rgba(255, 200, 93, 0.55);
    border-top-color: rgba(255, 200, 93, 0.55);
    border-bottom-color: rgba(255, 200, 93, 0.55);
}

.divider {
    height: 1px;
    margin-top: 19px;
    margin-bottom: 17px;
    background-color: rgba(255, 255, 255, 0.09);
}

.setting-label {
    color: rgb(221, 226, 238);
    font-size: 13px;
    -unity-font-style: bold;
}

.setting-value {
    color: rgb(166, 163, 255);
    font-size: 13px;
    -unity-font-style: bold;
}

.blend-slider {
    height: 24px;
    margin-top: 8px;
}

.blend-slider .unity-base-slider__tracker {
    height: 5px;
    background-color: rgb(44, 52, 69);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.blend-slider .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    background-color: rgb(132, 129, 255);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(238, 237, 255);
    border-right-color: rgb(238, 237, 255);
    border-top-color: rgb(238, 237, 255);
    border-bottom-color: rgb(238, 237, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.hint {
    color: rgb(121, 132, 154);
    font-size: 11px;
    margin-top: 5px;
}
